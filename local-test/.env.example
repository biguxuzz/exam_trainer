# Пример переменных окружения для local-test/docker-compose.yaml
# Запуск: docker compose --env-file .env.example up -d
#
# Добавьте сюда нужные переменные, которые читает приложение в контейнере.
#
SECRET_KEY=dev-secret-key-UNSAFE-change-in-production
FLASK_ENV=development
PYTHONUNBUFFERED=1

# Telegram Mini App (опционально — нужен токен бота из BotFather)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# MAX Mini App (опционально — нужен токен бота из платформы MAX для партнёров)
# MAX_BOT_TOKEN=your_max_bot_token_here
# MAX_AUTH_MAX_AGE_SECONDS=86400